{
    "name": "ujbenda/linux-mail-dashboard",
    "description": "Dohledový a administrační panel pro iRedMail (Postfix, Dovecot, Amavis) s přihlášením přes Active Directory",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-ldap": "*",
        "ext-mbstring": "*",
        "ext-sodium": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "MailPanel\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
